static var _font: FontFile


static func get_font() -> FontFile:
	if _font != null:
		return _font
	var cell := 8
	var cols := 16
	var rows := 6
	var img := Image.create(cols * cell, rows * cell, false, Image.FORMAT_RGBA8)
	img.fill(Color(1, 1, 1, 0))
	for gi in GLYPHS.size():
		var ox := (gi % cols) * cell
		var oy := (gi / cols) * cell
		var g: Array = GLYPHS[gi]
		for cx in 5:
			var bits: int = g[cx]
			for ry in 8:
				if (bits >> ry) & 1 == 1:
					img.set_pixel(ox + cx, oy + ry + 0, Color(1, 1, 1, 1))
	var f := FontFile.new()
	f.fixed_size = cell
	f.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	f.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	f.hinting = TextServer.HINTING_NONE
	f.subpixel_positioning = TextServer.SUBPIXEL_POSITIONING_DISABLED
	f.generate_mipmaps = false
	f.msdf_pixel_range = 14
	var sz := Vector2i(cell, 0)
	f.set_texture_image(0, sz, 0, img)
	f.set_cache_ascent(0, cell, 7.0)
	f.set_cache_descent(0, cell, 1.0)
	for gi in GLYPHS.size():
		var ch := 0x20 + gi
		var ox2 := (gi % cols) * cell
		var oy2 := (gi / cols) * cell
		f.set_glyph_advance(0, cell, ch, Vector2(6, 0))
		f.set_glyph_offset(0, sz, ch, Vector2(0, -7))
		f.set_glyph_size(0, sz, ch, Vector2(5, 8))
		f.set_glyph_uv_rect(0, sz, ch, Rect2(ox2, oy2, 5, 8))
		f.set_glyph_texture_idx(0, sz, ch, 0)
	_font = f
	return f
